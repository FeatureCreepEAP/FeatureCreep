  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <showWarnings>true</showWarnings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-java-25</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules><requireJavaVersion><version>[25,)</version></requireJavaVersion></rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <!-- other plugins omitted -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>2.4</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Premain-Class>
								asbestosstar.bootstrap.FeatureCreepAgent</Premain-Class>
              <Agent-Class>
								asbestosstar.bootstrap.FeatureCreepAgent</Agent-Class>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
              <Automatic-Module-Name>featurecreep.bootstrap</Automatic-Module-Name>
              <Main-Class>asbestosstar.bootstrap.FeatureCreepMain</Main-Class>
              <MixinConfigs>featurecreepimpl.mixins.json</MixinConfigs>
            <FeatureCreep-Artifact-Id>featurecreep-bootstrap</FeatureCreep-Artifact-Id></manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Exclude entire groups -->
                    <exclude>org.ow2.asm:*</exclude>
                    <exclude>com.mojang:*</exclude>
                    <exclude>io.netty:*</exclude>
                    <exclude>org.apache.commons:*</exclude>
                    <exclude>org.apache.httpcomponents:*</exclude>
                    <exclude>org.apache.logging.log4j:*</exclude>
                    <exclude>org.lwjgl:*</exclude>
                    <exclude>net.minecraftforge:*</exclude>
                    <exclude>cpw.mods:*</exclude>
                    <!-- Exclude individual artifacts -->
                    <exclude>ca.weblite:java-objc-bridge</exclude>
                    <exclude>com.github.oshi:oshi-core</exclude>
                    <exclude>
											com.google.guava:failureaccess</exclude>
                    <exclude>com.google.code.gson:gson</exclude>
                    <exclude>com.ibm.icu:icu4j</exclude>
                    <exclude>commons-codec:commons-codec</exclude>
                    <exclude>commons-io:commons-io</exclude>
                    <exclude>
											commons-logging:commons-logging</exclude>
                    <exclude>it.unimi.dsi:fastutil</exclude>
                    <exclude>
											net.sf.jopt-simple:jopt-simple</exclude>
                    <exclude>org.jcraft:jorbis</exclude>
                    <exclude>org.joml:joml</exclude>
                    <exclude>META-INF/services/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>
											asbestosstar.bootstrap.FeatureCreepAgent</Premain-Class>
                    <Agent-Class>
											asbestosstar.bootstrap.FeatureCreepAgent</Agent-Class>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                    <Automatic-Module-Name>
											featurecreep.bootstrap</Automatic-Module-Name>
                    <Main-Class>asbestosstar.bootstrap.FeatureCreepMain</Main-Class>
                    <MixinConfigs>featurecreepimpl.mixins.json</MixinConfigs>
                  <FeatureCreep-Artifact-Id>featurecreep-bootstrap</FeatureCreep-Artifact-Id></manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Maven Javadoc Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <encoding>${project.build.sourceEncoding}</encoding>
          <docencoding>${project.reporting.outputEncoding}</docencoding>
          <doclint>all,-missing</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Maven GPG Plugin -->
      <!-- Nexus Staging Maven Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
