        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>embed-standalone-installer-artifacts</id>
                <phase>process-resources</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>com.asbestosstar</groupId><artifactId>featurecreep-loader</artifactId><version>12</version>
                      <outputDirectory>${project.build.outputDirectory}/META-INF/featurecreep/artifacts</outputDirectory>
                      <destFileName>featurecreep-loader-12.jar</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>com.asbestosstar</groupId><artifactId>featurecreep-api</artifactId><version>12</version>
                      <outputDirectory>${project.build.outputDirectory}/META-INF/featurecreep/artifacts</outputDirectory>
